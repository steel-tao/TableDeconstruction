# WeChat Configuration Example
# 微信公众号配置示例

# 应用ID (AppID)
WECHAT_APP_ID=your_app_id

# 应用密钥 (AppSecret)
WECHAT_APP_SECRET=your_app_secret

# 消息校验Token
WECHAT_TOKEN=your_token

# 消息加密密钥
WECHAT_ENCODING_AES_KEY=your_aes_key

# Obsidian Configuration
# Obsidian配置

# Obsidian Vault路径
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# 内容文件夹名称
OBSIDIAN_CONTENT_FOLDER=content

# System Configuration
# 系统配置

# 运行环境: development | production
NODE_ENV=development

# 服务器端口
PORT=3000

# 服务器主机
HOST=localhost

# 数据库类型
DB_TYPE=sqlite

# 数据库路径
DB_PATH=./data/app.db

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 排版主题
RENDER_THEME=default

# 是否启用响应式设计
RENDER_RESPONSIVE=true
