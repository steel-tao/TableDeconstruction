{
  "name": "weixin-content-management",
  "version": "0.1.0",
  "description": "微信公众号智能化内容管理与发布系统",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "setup": "node scripts/setup.js",
    "dev:watch": "node scripts/dev-server.js",
    "doocs:install": "npm install --prefix tools/doocs @doocs/md-cli",
    "doocs:start": "node tools/doocs/node_modules/@doocs/md-cli/index.js --port 8899"
  },
  "keywords": [
    "wechat",
    "content-management",
    "markdown",
    "doocs",
    "obsidian",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.4.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "gray-matter": "^4.0.3",
    "marked": "^9.1.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "yaml": "^2.3.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.5",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^8.10.0",
    "jest": "^29.6.2",
    "prettier": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  }
}
