{
  "name": "weixin-content-management",
  "version": "0.1.0",
  "type": "module",
  "description": "微信公众号智能化内容管理与发布系统",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "setup": "node scripts/setup.js",
    "dev:watch": "node scripts/dev-server.js",
    "start-all": "node scripts/start-all-services.cjs",
    "start:file-manager": "node tools/file-manager/start.cjs",
    "start:doocs": "node tools/doocs/start.cjs",
    "doocs:install": "npm install --prefix tools/doocs @doocs/md-cli",
    "doocs:start": "node tools/doocs/node_modules/@doocs/md-cli/index.js --port 8899",
    "vault:list": "node src/cli.js list",
    "vault:extract": "node src/cli.js extract",
    "vault:search": "node src/cli.js search",
    "vault:stats": "node src/cli.js stats",
    "vault:export": "node src/cli.js export",
    "workflow:demo": "node src/e2e-workflow.js",
    "workflow:start": "node src/e2e-workflow.js",
    "test:wechat-api": "node scripts/test-wechat-api.cjs",
    "test:wechat-mock": "WECHAT_ADAPTER=mock node scripts/test-wechat-api.cjs",
    "test:publish-flow": "jest src/services/publish --coverage",
    "demo:publish": "node scripts/demo-publish-workflow.cjs",
    "start:server": "npm run build && node --experimental-specifier-resolution=node start-server.mjs",
    "start:api": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:api": "PORT=3000 ts-node-dev --respawn --transpile-only src/server.ts",
    "test:publish-api": "node scripts/test-publish-api.cjs",
    "test:api": "concurrently -k \"npm run dev:api\" \"sleep 3 && npm run test:publish-api\""
  },
  "keywords": [
    "wechat",
    "content-management",
    "markdown",
    "doocs",
    "obsidian",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.4.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "commander": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "marked": "^9.1.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "yaml": "^2.3.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^8.10.0",
    "jest": "^29.6.2",
    "prettier": "^3.0.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  }
}
